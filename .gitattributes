internal/winhcs/internal/hcs/schema2/properties.go linguist-generated=false
internal/winhcs/hcn/hcnendpoint.go linguist-generated=false
internal/winhcs/hcn/hcnsupport.go linguist-generated=false
internal/winhcs/hcn/hcnerrors.go linguist-generated=false
internal/winhcs/hcn/hcnglobals.go linguist-generated=false
internal/winhcs/hcn/hcnnetwork.go linguist-generated=false
internal/winhcs/internal/hcs/system.go linguist-generated=false
internal/winhcs/internal/hcs/callback.go linguist-generated=false
