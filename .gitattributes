# internal/winhcs is vendored github.com/Microsoft/hcsshim, kept
# byte-identical to upstream except the modifications internal/winhcs/README.md
# documents -- linguist-generated keeps `bazel run //tools/format` (which
# honors this attribute) from reformatting it and drifting away from
# upstream's own formatting. The hand-authored/modified files are re-marked
# false below so they still get formatted normally.
internal/winhcs/** linguist-generated=true
internal/winhcs/README.md linguist-generated=false
internal/winhcs/internal/log/context.go linguist-generated=false
internal/winhcs/internal/log/context_test.go linguist-generated=false
internal/winhcs/internal/log/scrub.go linguist-generated=false
internal/winhcs/internal/oc/errors.go linguist-generated=false
