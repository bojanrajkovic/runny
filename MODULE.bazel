"""runny — observable macOS GitHub Actions runner daemon, CLI, and menu-bar app."""

module(name = "runny")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# sh_test for apps/Runny's signed-bundle contents check. Already the graph-
# selected transitive version, so promoting it to a direct dep changes no
# resolved versions.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Prebuilt SwiftFormat (nicklockwood) binaries for //tools/format.
format_tools = use_extension("@aspect_rules_lint//format:extensions.bzl", "tools")
format_tools.swiftformat()
use_repo(format_tools, "swiftformat", "swiftformat_mac")

#########################
# Swift / Apple (Runny app; daemon entitlement signing)
# Toolchains resolve only on macOS hosts; Linux builds of Go targets are unaffected.
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_apple", version = "5.4.0")

#########################
# Protobuf (runny.v1 contract, generated in-graph)
bazel_dep(name = "protobuf", version = "36.2")

#########################
# Go
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//tools/lint:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_alecthomas_kong", "com_github_code_hex_vz_v3", "com_github_goccy_go_yaml", "com_github_golang_jwt_jwt_v5", "com_github_invopop_jsonschema", "com_github_microsoft_go_winio", "com_github_pierrec_lz4_v4", "com_github_pkg_errors", "com_github_rivo_uniseg", "io_opencensus_go", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "net_howett_plist", "org_golang_google_grpc", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_sync", "org_golang_x_sys", "org_golang_x_term")
