"""runny — observable macOS GitHub Actions runner daemon, CLI, and menu-bar app."""

module(name = "runny")

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_rules_lint", version = "2.0.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")

#########################
# Swift / Apple (RunnyBar app; daemon entitlement signing)
# Toolchains resolve only on macOS hosts; Linux builds of Go targets are unaffected.
bazel_dep(name = "apple_support", version = "2.6.1")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_apple", version = "4.5.3")

#########################
# Protobuf (runny.v1 contract, generated in-graph)
bazel_dep(name = "protobuf", version = "35.0")

#########################
# Go
bazel_dep(name = "rules_go", version = "0.61.0")
bazel_dep(name = "gazelle", version = "0.51.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//tools/lint:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_goccy_go_yaml", "org_golang_x_crypto", "org_golang_x_sys")
