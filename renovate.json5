{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // best-practices = recommended + docker:pinDigests + helpers:pinGitHubActionDigests
  // + :configMigration + :pinDevDependencies + abandonments:recommended
  // + security:minimumReleaseAgeNpm + :maintainLockFilesWeekly
  extends: ['config:best-practices'],
  semanticCommits: 'enabled',
  // No schedule: the supply-chain delay is minimumReleaseAge (deterministic),
  // not a weekly batch (a random 0-7 day lag); automerge absorbs the noise.
  // Observed malware-takedown windows in the 2025 npm attacks were
  // hours-to-days; 7 days clears them with margin. Vulnerability PRs
  // bypass the cooldown.
  minimumReleaseAge: '7 days',
  // Renovate merges after CI is green rather than via GitHub auto-merge:
  // Renovate is a bypass actor on the Protect Main ruleset, so platform
  // auto-merge is not guaranteed to wait on the required checks.
  platformAutomerge: false,
  automergeStrategy: 'squash',
  // Dependabot alerts are enabled on the repo; OSV adds a second source.
  vulnerabilityAlerts: { labels: ['security'] },
  osvVulnerabilityAlerts: true,
  // Branches opened by the Mend-hosted Renovate app carry its commits. This
  // list replaces the self-hosted global one rather than merging with it, so
  // it repeats that bot; without it, Renovate treats those branches as
  // human-edited and stops rebasing them.
  gitIgnoredAuthors: ['29139614+renovate[bot]@users.noreply.github.com'],
  // gomodTidyE, not gomodTidy: plain `go mod tidy` aborts mid-attribution on
  // the in-graph proto import and mangles every dep to `// indirect` — the
  // `-e` is load-bearing (CONTRIBUTING.md "Known wrinkle").
  postUpdateOptions: ['gomodTidyE'],
  // Renovate's gomod artifact step runs `go get -t <goGetDirs>` before
  // `go mod tidy -e`. The default `./...` loads every package and fails on
  // the in-graph-only proto import (ADR-0006). `./proto/...` holds no Go
  // files, so `go get` matches no packages and succeeds, and `go mod tidy -e`
  // then updates go.sum.
  goGetDirs: ['./proto/...'],
  packageRules: [
    {
      description: 'Go bumps can add or drop packages: rerun gazelle and bazel mod tidy (CONTRIBUTING.md "Dependency workflow").',
      matchManagers: ['gomod'],
      postUpgradeTasks: {
        commands: ['scripts/renovate/go-sum.sh'],
        fileFilters: ['go.mod', 'go.sum', 'MODULE.bazel', 'MODULE.bazel.lock', '**/BUILD', '**/BUILD.bazel'],
        executionMode: 'branch',
      },
    },
    {
      description: 'MODULE.bazel and bazel version bumps need a fresh MODULE.bazel.lock; CI runs --lockfile_mode=error.',
      matchManagers: ['bazel-module'],
      postUpgradeTasks: {
        commands: ['scripts/renovate/bazel-lockfile.sh'],
        fileFilters: ['MODULE.bazel.lock'],
        executionMode: 'branch',
      },
    },
    {
      description: 'A new bazel version resolves different implicit deps; same lockfile regeneration.',
      matchManagers: ['mise'],
      matchDepNames: ['bazel'],
      postUpgradeTasks: {
        commands: ['scripts/renovate/bazel-lockfile.sh'],
        fileFilters: ['MODULE.bazel.lock'],
        executionMode: 'branch',
      },
    },
    {
      description: 'Bazel rules move together; group them.',
      matchManagers: ['bazel-module'],
      groupName: 'bazel module deps',
    },
    {
      description: 'Automerge non-major library updates once CI is green; 0.x stays manual (no compat contract).',
      matchManagers: ['gomod', 'npm', 'bazel-module'],
      matchUpdateTypes: ['minor', 'patch'],
      matchCurrentVersion: '!/^v?0\\./',
      automerge: true,
    },
    {
      description: 'Actions are SHA-pinned; automerge digest/pin motion and non-major tag bumps.',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin'],
      automerge: true,
    },
    {
      description: 'Toolchains (bazel/go/node) change what builds the release binary; automerge patches only.',
      matchManagers: ['mise'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      description: 'Pin conversions change no resolved version; automerge unconditionally.',
      matchUpdateTypes: ['pin', 'pinDigest'],
      automerge: true,
    },
    {
      description: 'The 7-day cooldown applies to npm too, overriding the preset 3-day npm rule (last match wins).',
      matchDatasources: ['npm'],
      minimumReleaseAge: '7 days',
    },
  ],
}
