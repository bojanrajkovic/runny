<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coderinserepeat.runnyd</string>

  <key>ProgramArguments</key>
  <array>
    <string>@RUNNYD@</string>
  </array>

  <!-- A per-user LaunchAgent (in ~/Library/LaunchAgents): it runs inside the
       user's GUI login session, which is what surfaces the one-time macOS
       "Local Network" (TCC) prompt and lets the grant persist. A runnyd that
       background-reparents off launchd loses that and is silently denied vmnet
       access — guest dials fail "no route to host". See docs/deploy.md. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- KeepAlive is load-bearing for the wedge restart (ADR-0012) AND for
       config reload (ADR-0014): when a guest survives force-stop, or after
       a `runnyctl reload` drains the fleet, runnyd exits non-zero expecting
       launchd to cold-start it — process exit is the only thing that
       reclaims an in-process VM, and the respawn is what applies a reloaded
       config. Stop the daemon with `launchctl bootout`, never by killing
       it, to avoid an immediate respawn. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Pre-log crash output only; the daemon's own structured log rotates
       under ~/.runny/logs/runnyd.log. @RUNNY_HOME@ is substituted at install
       time with the run-user's fixed ~/.runny — the same path the daemon
       derives from $HOME (there is no environment override). -->
  <key>StandardOutPath</key>
  <string>@RUNNY_HOME@/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>@RUNNY_HOME@/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
