# Generated by runny's release workflow (ADR-0010) from this template
# (tools/deploy/runny-app-beta.rb.tmpl) whenever a GitHub pre-release
# publishes. Do not edit the copy in the tap by hand — the next beta
# overwrites it. version, url, and sha256 are filled in by the workflow from
# the package step's own checksum, never a re-download.
#
# Beta channel counterpart to runny-app.rb.tmpl: same bundle, built from a
# pre-release tag instead of a stable one. The app bundle itself is still
# named Runny.app (that's the Xcode product name, not something this cask
# controls), so this and the stable cask can't be installed side by side —
# brew's own "an App already exists at that path" guard catches that; no
# extra preflight needed here beyond the formula check below.
cask "runny-app-beta" do
  version "${VERSION}"
  sha256 "${DMG_SHA}"

  url "${DMG_URL}"
  name "Runny (Beta)"
  desc "Observable macOS GitHub Actions runner daemon on Virtualization.framework (beta channel)"
  homepage "https://github.com/bojanrajkovic/runny"

  depends_on arch:  :arm64
  depends_on macos: ">= :sequoia"   # mirrors minimum_os_version = "15.0" in apps/Runny/BUILD

  app "Runny.app"
  # binary target is Contents/MacOS/runnyctl — asserted by //apps/Runny:bundle_contents_test.
  # The formula refuses when this cask is present (conflicts_with cask: "runny-app-beta"
  # in runny-beta.rb.tmpl), so formula users can't brew install runny-beta to get the CLI.
  binary "#{appdir}/Runny.app/Contents/MacOS/runnyctl"

  preflight do
    if (HOMEBREW_PREFIX/"bin/runnyd").exist?
      odie "A `runny` or `runny-beta` formula install is already present. Run " \
           "'brew uninstall runny' or 'brew uninstall runny-beta' first."
    end
  end

  uninstall quit:      "com.coderinserepeat.runny",      # app bundle id
            launchctl: "com.coderinserepeat.runnyd"      # per-user LaunchAgent label

  caveats <<~EOS
    This is the beta channel: a pre-release build tagged directly from a
    commit (see ADR-0010), not a release-please stable release.

    Runny.app manages the per-user runnyd LaunchAgent itself
    (Settings -> Daemon -> "Start runnyd at login"). This cask is mutually
    exclusive with the `runny` and `runny-beta` formulas, and with the
    stable `runny-app` cask (same app bundle) — use one manager, one
    channel, at a time.
  EOS
end
