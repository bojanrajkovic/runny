# typed: false
# frozen_string_literal: true

# Generated by runny's release workflow (ADR-0010) from this template
# (tools/deploy/runny-beta.rb.tmpl) whenever a GitHub pre-release publishes.
# Do not edit the copy in the tap by hand — the next beta overwrites it.
# version, url, and sha256 are filled in by the workflow from the package
# step's own checksum, never a re-download.
#
# This is the beta channel: same delivery shape as the `runny` formula, but
# tracking pre-release tags (ADR-0010's manual `<next>-beta.<shortsha>`
# tags) instead of release-please's stable tags. Mutually exclusive with
# `runny` and both casks — one manager, one channel, at a time.
class RunnyBeta < Formula
  desc "Observable macOS GitHub Actions runner daemon on Virtualization.framework (beta channel)"
  homepage "https://github.com/bojanrajkovic/runny"
  version "${VERSION}"
  url "${URL}"
  sha256 "${SHA}"
  license "MIT"

  depends_on :macos
  depends_on arch: :arm64

  conflicts_with "runny", because: "both install the runnyd and runnyctl binaries"
  # Mutual exclusion vs. casks lives here only — see the comment in
  # runny.rb.tmpl on why the cask side can't declare the reverse.
  conflicts_with cask: "runny-app"
  conflicts_with cask: "runny-app-beta"

  def install
    bin.install "runnyd"
    bin.install "runnyctl"
  end

  # This formula is delivery-only: it installs the binaries, not a service. See
  # runny.rb.tmpl's comment on why `brew services` can't cover the headless case.

  def caveats
    <<~TEXT
      This is the beta channel: a pre-release build tagged directly from a
      commit (see ADR-0010), not a release-please stable release. Expect it
      to move faster and break more than `runny`.

      Choose one supported path:

        Headless / server host:
            sudo runnyctl install-daemon
            $EDITOR "/Library/Application Support/runny/config.yaml"

        Desktop / per-user:
            Open Runny.app, then Settings -> Daemon -> "Start runnyd at login"

      To go back to stable: brew uninstall runny-beta && brew install runny
    TEXT
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/runnyctl version")
  end
end
