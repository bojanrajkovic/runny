<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by runny's release workflow (ADR-0010) from this template
  (tools/deploy/runny.nuspec.tmpl). Do not edit the copy attached to a
  release by hand — the next release overwrites it. version and the two
  binary checksums are filled in by the workflow from the exact exes packed
  alongside this nuspec, never a re-download.

  Published to the self-hosted feed at https://bojanrajkovic.github.io/choco-feed/
  (a static NuGet v3 feed generated by Sleet, the Chocolatey counterpart to
  homebrew-tap) and attached to the release. Install either way:

    choco source add -n=runny -s=https://bojanrajkovic.github.io/choco-feed/index.json
    choco install runny

  or `choco install <downloaded-path>` straight from a release asset.
  Chocolatey 2.4.1+ is required for the feed: before that fix (choco#3396),
  v3-only feeds could not resolve an explicitly pinned version.

  Upgrades are graceful: chocolateyBeforeModify.ps1 drains and stops the runnyd
  service before Chocolatey swaps this package's files (the service is
  registered against lib\runny\tools\runnyd.exe, and Windows locks a running
  image), and chocolateyInstall.ps1 starts it again if it was running. The hook
  runs from the OLD package's copy, so it only governs upgrades FROM a version
  that ships it.

  Both runnyd.exe and runnyctl.exe land in tools/, which Chocolatey auto-shims
  onto PATH (any .exe directly under tools/ gets a shim unless suffixed
  .exe.ignore). `runnyctl install-daemon` resolves runnyd.exe as a sibling of
  the running runnyctl, which lands on the real lib\runny\tools\ path rather
  than the shim, so the registered service points at the binary Chocolatey
  replaces in place on upgrade.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>runny</id>
    <version>${VERSION}</version>
    <title>runny</title>
    <authors>Bojan Rajkovic</authors>
    <owners>Bojan Rajkovic</owners>
    <projectUrl>https://github.com/bojanrajkovic/runny</projectUrl>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Observable GitHub Actions runner daemon on Hyper-V (ADR-0026). This package delivers the runnyd and runnyctl binaries only — it registers no service. See docs/deploy.md's "Windows" section for `runnyctl install-daemon`.</description>
    <tags>admin</tags>
  </metadata>
  <files>
    <file src="tools\runnyd.exe" target="tools" />
    <file src="tools\runnyctl.exe" target="tools" />
    <file src="tools\VERIFICATION.txt" target="tools" />
    <file src="tools\chocolateyBeforeModify.ps1" target="tools" />
    <file src="tools\chocolateyInstall.ps1" target="tools" />
  </files>
</package>
